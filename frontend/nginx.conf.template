# nginx config template for the production frontend image.
# The official nginx image fills in ${API_UPSTREAM} from the container's environment
# at start (files in /etc/nginx/templates/). Set it on the Cloud Run service, e.g.
#   API_UPSTREAM=https://math-buddy-api-670264226001.us-central1.run.app
# nginx's own $variables are left alone because they are not environment variables.

server {
    listen 80;

    # The app and its API share one address, so the sign-in cookie (HttpOnly,
    # SameSite=Strict, Path=/api/v1/auth) works. The browser never calls the API host.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_ssl_server_name on;          # Cloud Run needs SNI for its HTTPS address
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 25m;          # Writing Coach: up to 6 photos per answer
        proxy_read_timeout 300s;           # AI marking/generation can take a while
        proxy_send_timeout 300s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;  # /parent, /admin/<token> etc. are app routes
    }
}
