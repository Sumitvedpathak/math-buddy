# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Required: Your OpenRouter API key
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1------

# Optional: Override the model (default: google/gemini-2.0-flash-001)
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Comma-separated allowed CORS origins (default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres for profiles / attempts / progress (grade 7 curriculum tracking).
# Optional: without it the question/evaluate endpoints still work, the rest return 503.
# Local: `docker compose up db`, then `alembic upgrade head` from backend/.
# MATH_BUDDY_DATABASE_URL=postgresql+asyncpg://mathbuddy:mathbuddy@localhost:5432/mathbuddy
# Hosted Postgres (Neon etc.): paste the provider URL as-is, e.g.
#   postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# (use the DIRECT host, not "-pooler", for migrations)

# Admin API secret (X-Admin-Token header). Unset = /api/v1/admin/* always 404.
# Generate with: python scripts/generate_admin_token.py --write-env
# MATH_BUDDY_ADMIN_TOKEN=

# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
# LOG_LEVEL=INFO

# LOG_FORMAT: "text" for local dev terminal, "json" for cloud deployment
# Set to "json" in production so log aggregators (GCP, AWS, Azure) parse records correctly.
# LOG_FORMAT=text
